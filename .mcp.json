{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "codex-app-server": {
      "type": "stdio",
      "command": "npm",
      "args": [
        "exec",
        "--yes",
        "--install-links",
        "--package=${CLAUDE_PLUGIN_ROOT}",
        "--package=husky@^9.1.7",
        "--",
        "codex-app-server"
      ],
      "env": { "NODE_USE_SYSTEM_CA": "1" }
    }
  }
}
