{
  "name": "@ririnto/codex-app-server",
  "version": "1.1.2",
  "private": true,
  "description": "Stdio MCP access to the running Codex app-server Unix control socket.",
  "license": "MIT",
  "bin": {
    "codex-app-server": "./server.mjs",
    "codex-thread-monitor": "./monitor.mjs"
  },
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "server.mjs",
    "monitor.mjs",
    "lib/",
    "skills/"
  ],
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:runtime": "node --test tests/server.test.mjs",
    "check:markdown-rules": "node --test tests/markdown-rules.test.mjs",
    "check:issue-forms": "node release/check-issue-forms.mjs",
    "check:plugin-version": "node release/check-plugin-version.mjs",
    "check:validation-tests": "node --test tests/validation.test.mjs",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:types": "tsc -p jsconfig.json --noEmit --pretty false",
    "check:ultracite": "ultracite check --type-aware",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "ultracite fix",
    "check:plugin-tests": "node --test tests/plugin.test.mjs",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "execa": "^10.2.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "husky": "catalog:",
    "js-yaml": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-relative-links": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "pnpm@12.16.1"
}
