{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": [
    "**/*.cjs",
    "**/.*/**/*.cjs",
    "**/.*.cjs",
    "**/.*/**/.*.cjs",
    "**/*.cts",
    "**/.*/**/*.cts",
    "**/.*.cts",
    "**/.*/**/.*.cts",
    "**/*.js",
    "**/.*/**/*.js",
    "**/.*.js",
    "**/.*/**/.*.js",
    "**/*.jsx",
    "**/.*/**/*.jsx",
    "**/.*.jsx",
    "**/.*/**/.*.jsx",
    "**/*.mjs",
    "**/.*/**/*.mjs",
    "**/.*.mjs",
    "**/.*/**/.*.mjs",
    "**/*.mts",
    "**/.*/**/*.mts",
    "**/.*.mts",
    "**/.*/**/.*.mts",
    "**/*.ts",
    "**/.*/**/*.ts",
    "**/.*.ts",
    "**/.*/**/.*.ts",
    "**/*.tsx",
    "**/.*/**/*.tsx",
    "**/.*.tsx",
    "**/.*/**/.*.tsx"
  ]
}
